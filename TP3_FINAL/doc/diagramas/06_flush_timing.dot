        <TR><TD>Segundo avance</TD><TD>28</TD><TD BGCOLOR="#e5f6ea">24: destino</TD><TD BGCOLOR="#f0f0f0">Burbuja</TD><TD BGCOLOR="#f0f0f0">Burbuja</TD><TD BGCOLOR="#fff0c7">8: salto</TD></TR>
        <TR><TD>Tercer avance</TD><TD>32</TD><TD>28</TD><TD BGCOLOR="#e5f6ea">24: destino</TD><TD BGCOLOR="#f0f0f0">Burbuja</TD><TD BGCOLOR="#f0f0f0">Burbuja</TD></TR>
