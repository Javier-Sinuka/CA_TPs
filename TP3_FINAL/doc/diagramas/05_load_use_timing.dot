digraph timing {
    graph [bgcolor="white", pad="0.3", fontname="DejaVu Sans", labelloc=t, label="Una burbuja permite que el load llegue a WB", fontsize=19];
    node [shape=plain, fontname="DejaVu Sans", fontsize=12];
    table [label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="13" COLOR="#a8b6ca">
        <TR><TD BGCOLOR="#243b57"><FONT COLOR="white">Instante</FONT></TD><TD BGCOLOR="#243b57"><FONT COLOR="white">IF</FONT></TD><TD BGCOLOR="#243b57"><FONT COLOR="white">ID</FONT></TD><TD BGCOLOR="#243b57"><FONT COLOR="white">EX</FONT></TD><TD BGCOLOR="#243b57"><FONT COLOR="white">MEM</FONT></TD><TD BGCOLOR="#243b57"><FONT COLOR="white">WB</FONT></TD></TR>
        <TR><TD ALIGN="LEFT">Riesgo detectado</TD><TD>Siguiente</TD><TD BGCOLOR="#eaf2ff">Consumidor C</TD><TD BGCOLOR="#dff2e4">Load L</TD><TD>Anterior</TD><TD>Anterior</TD></TR>
        <TR><TD ALIGN="LEFT">Primer avance<BR/>stall habilitado</TD><TD BGCOLOR="#fff0c7">Conserva PC</TD><TD BGCOLOR="#fff0c7">C retenido</TD><TD BGCOLOR="#ffe3dc">Burbuja<BR/>valid/control = 0</TD><TD BGCOLOR="#dff2e4">L lee dmem</TD><TD>Anterior avanza</TD></TR>
        <TR><TD ALIGN="LEFT">Segundo avance<BR/>riesgo liberado</TD><TD>PC + 4</TD><TD>Siguiente</TD><TD BGCOLOR="#eaf2ff">C recibe dato<BR/>forwarding 01</TD><TD BGCOLOR="#ffe3dc">Burbuja</TD><TD BGCOLOR="#dff2e4">L: dato final</TD></TR>
        <TR><TD ALIGN="LEFT">Tercer avance</TD><TD>Avanza</TD><TD>Avanza</TD><TD>Siguiente</TD><TD BGCOLOR="#eaf2ff">C avanza</TD><TD BGCOLOR="#ffe3dc">Burbuja</TD></TR>
        <TR><TD COLSPAN="6" BGCOLOR="#f4f6f9">L y C son consecutivos en el programa. Penalidad: un avance extra.<BR/>Los clocks con i_en = 0 conservan la fila actual; no cuentan como stalls habilitados.</TD></TR>
      </TABLE>
    >];
}
